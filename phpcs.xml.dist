<?xml version="1.0"?>
<ruleset name="Serbian Transliteration">
	<description>PHP_CodeSniffer rules for Serbian Transliteration.</description>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="p"/>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>
	<exclude-pattern>*/.github/*</exclude-pattern>

	<rule ref="WordPress">
		<!-- Keep the existing plugin file naming convention. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

		<!-- Do not require documentation blocks in legacy code. -->
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>

		<!-- Short array syntax is intentionally used by this project. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>
</ruleset>